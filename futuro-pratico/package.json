{
  "name": "futuro-pratico",
  "version": "1.0.0",
  "description": "Futuro Prático — Reel de 20 segundos sobre inteligência artificial",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "@remotion/media": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "node scripts/render-v2.cjs",
    "check:studio": "node scripts/check-studio.cjs",
    "audio": "python3 scripts/make_audio.py",
    "render:v2": "node scripts/render-v2.cjs",
    "render:teste02": "node scripts/render-teste02.cjs",
    "validate:teste02": "python3 scripts/validate_teste02.py",
    "render:roadster": "node scripts/render-roadster.cjs",
    "validate:roadster": "python3 scripts/validate_roadster.py",
    "fp:doctor": "python3 scripts/futuro-pratico/doctor.py",
    "fp:assets:inspect": "python3 scripts/futuro-pratico/assets.py inspect",
    "fp:assets:import": "python3 scripts/futuro-pratico/assets.py import",
    "fp:assets:validate": "python3 scripts/futuro-pratico/assets.py validate",
    "fp:episode": "python3 scripts/futuro-pratico/pipeline.py",
    "fp:test": "node --test tests/futuro-pratico/*.test.mjs && python3 -m unittest discover -s tests/futuro-pratico -p \"test_*.py\"",
    "fp:preview": "remotion studio src/index.ts --no-open",
    "fp:stills": "node scripts/futuro-pratico/qa-stills.mjs",
    "fp:export": "node scripts/futuro-pratico/export.mjs",
    "fp:skills:validate": "python3 scripts/futuro-pratico/check_skills.py",
    "fp:check:studio": "node scripts/futuro-pratico/check-studio.cjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
